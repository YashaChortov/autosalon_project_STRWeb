# ==========================================================
# .gitignore для проекта IGI_LabWork5
# ==========================================================
# ВАЖНО: строки, помеченные #, отключены.
# Чтобы исключить файл из Git — убери # в начале строки.
# Чтобы вернуть в Git — поставь # обратно.
# ==========================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Виртуальные окружения ----------
# Виртуальное окружение в Git не нужно — оно ставится из requirements.txt
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/
__pypackages__/

# ---------- Тесты и кэш ----------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ---------- Django ----------
# Логи — не нужны
*.log
local_settings.py

# База данных — РАСКОММЕНТИРУЙ, если НЕ хочешь хранить её в Git
# db.sqlite3
# db.sqlite3-journal

# Медиа-файлы (загруженные картинки, баннеры, фото) —
# РАСКОММЕНТИРУЙ, если НЕ хочешь хранить их в Git
# media/

# Статика, собранная collectstatic — в Git не нужна
/staticfiles/

# ---------- PyCharm / JetBrains ----------
# Папка .idea содержит личные настройки IDE — обычно не коммитится
# Раскомментируй строку ниже, чтобы скрыть её из Git
#.idea/

# ---------- VS Code ----------
# .vscode/

# ---------- Операционные системы ----------
.DS_Store
Thumbs.db

# ---------- Секреты и переменные окружения ----------
.env
*.pem
*.key

# ---------- Прочее ----------
*.mo
*.pot
docs/_build/
/site
instance/
.scrapy
.ipynb_checkpoints
profile_default/
ipython_config.py
celerybeat-schedule
celerybeat.pid
*.sage.py
.spyderproject
.spyproject
.ropeproject
cython_debug/
.pdm.toml
.pdm-python
.pdm-build/
.abstra/
.pypirc
.cursorignore
.cursorindexingignore